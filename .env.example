# TopCare 종사자 앱 — 환경 변수 예시
# 실제 값은 .env 또는 EAS Secret 으로 주입 (커밋 금지)

# 웹 백엔드(Next.js) API 베이스 URL. 끝에 슬래시 없이.
# 로컬 개발: 에뮬레이터/실기기에서 localhost 접근 방식이 다름.
#   - Android 에뮬레이터: http://10.0.2.2:3000
#   - iOS 시뮬레이터:    http://localhost:3000
#   - 실기기:            http://<개발PC-LAN-IP>:3000
EXPO_PUBLIC_API_URL=http://localhost:3000

# (선택) Supabase 직접 접근용 — Realtime/Storage 등 후속 기능에서 사용
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
