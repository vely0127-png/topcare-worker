{
  "expo": {
    "name": "TopCare 종사자",
    "slug": "topcare-worker",
    "scheme": "topcare-worker",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "splash": {
      "resizeMode": "contain",
      "backgroundColor": "#1A5276"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "kr.topcare.worker",
      "infoPlist": {
        "NSBluetoothAlwaysUsageDescription": "근무 출퇴근 자동 인증을 위해 시설에 설치된 BLE 비콘 신호를 감지합니다.",
        "NSBluetoothPeripheralUsageDescription": "근무 출퇴근 자동 인증을 위해 시설에 설치된 BLE 비콘 신호를 감지합니다.",
        "NSLocationWhenInUseUsageDescription": "BLE 비콘 근접 감지를 위해 기기 위치 권한이 필요합니다.",
        "UIBackgroundModes": [
          "bluetooth-central"
        ]
      }
    },
    "android": {
      "package": "kr.topcare.worker",
      "adaptiveIcon": {
        "backgroundColor": "#1A5276"
      },
      "permissions": [
        "android.permission.BLUETOOTH_SCAN",
        "android.permission.BLUETOOTH_CONNECT",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_CONNECTED_DEVICE",
        "android.permission.BLUETOOTH",
        "android.permission.BLUETOOTH_ADMIN"
      ]
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-dev-client",
      [
        "react-native-ble-plx",
        {
          "isBackgroundEnabled": true,
          "modes": [
            "central"
          ],
          "bluetoothAlwaysPermission": "근무 출퇴근 자동 인증을 위해 시설에 설치된 BLE 비콘 신호를 감지합니다."
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 23
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": false
    },
    "extra": {
      "router": {
        "origin": false
      }
    }
  }
}
