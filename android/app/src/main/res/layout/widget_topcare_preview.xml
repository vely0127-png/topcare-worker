<?xml version="1.0" encoding="utf-8"?>
<!--
  런처 위젯 선택 화면 미리보기 전용(API 31+ previewLayout, widget_topcare_info.xml).
  런타임에 TopCareWidgetProvider가 이 파일을 절대 건드리지 않는다 — 여기 텍스트는
  전부 하드코딩된 더미 데이터다(명세 C-3: 미리보기 실데이터 0).
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/widget_bg_normal"
    android:padding="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/app_name"
            android:textColor="@color/colorPrimaryDark"
            android:textStyle="bold"
            android:textSize="13sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="09:00 기준"
            android:textColor="#8A8A8A"
            android:textSize="11sp" />
    </LinearLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="@string/widget_section_alerts"
        android:textColor="@color/colorPrimary"
        android:textStyle="bold"
        android:textSize="12sp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="000호 예시 — 예시 항목"
        android:textSize="12sp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="@string/widget_section_services"
        android:textColor="@color/colorPrimary"
        android:textStyle="bold"
        android:textSize="12sp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="000호 예시 — 예시 서비스 (00:00)"
        android:textSize="12sp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="@string/widget_section_directives"
        android:textColor="@color/colorPrimary"
        android:textStyle="bold"
        android:textSize="12sp" />

</LinearLayout>
