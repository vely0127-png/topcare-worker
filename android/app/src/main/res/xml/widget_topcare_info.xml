<?xml version="1.0" encoding="utf-8"?>
<!--
  홈 위젯 v1(표시형) 메타데이터. ADR-001 §4-2:
  - updatePeriodMillis=1800000(30분)은 재부팅에도 시스템이 보장하는 백스톱이다.
    (WorkManager가 프로젝트에 없어 15분 목표치는 TopCareWidgetProvider의
    AlarmManager.setInexactRepeating으로 보완 — 정확 알람 권한은 요구하지 않는다.)
  - previewLayout(API 31+)과 previewImage(그 이하)는 전부 더미/앱 아이콘이다.
    실데이터가 런처 미리보기에 노출되는 일은 없다(명세 C-3).
  - widgetCategory는 home_screen만 선언한다. 표준 keyguard 카테고리는
    API 21 이후 잠금화면 위젯 자체가 폐지돼 사실상 no-op이고, Samsung One UI 7+의
    잠금화면 위젯 패널은 이 플래그 없이 홈 화면 provider를 그대로 재사용하는
    벤더 자체 메커니즘이라 별도 선언이 필요 없다(실기기 확인은 ADR §7 스파이크 항목).
-->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:minWidth="110dp"
    android:minHeight="110dp"
    android:targetCellWidth="2"
    android:targetCellHeight="2"
    android:maxResizeWidth="250dp"
    android:maxResizeHeight="180dp"
    android:resizeMode="horizontal|vertical"
    android:widgetCategory="home_screen"
    android:updatePeriodMillis="1800000"
    android:initialLayout="@layout/widget_topcare"
    android:previewLayout="@layout/widget_topcare_preview"
    android:previewImage="@mipmap/ic_launcher"
    android:description="@string/widget_description" />
